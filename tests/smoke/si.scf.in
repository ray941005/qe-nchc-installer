! Bulk silicon SCF. Small enough to run in a few seconds on two ranks, but
! still exercises FFTs, dense linear algebra, k-point distribution over MPI
! and stress/force evaluation.
&CONTROL
    calculation  = 'scf'
    prefix       = 'si'
    outdir       = './out'
    pseudo_dir   = './'
    tprnfor      = .true.
    tstress      = .true.
    verbosity    = 'low'
/
&SYSTEM
    ibrav        = 2
    celldm(1)    = 10.20
    nat          = 2
    ntyp         = 1
    ecutwfc      = 18.0
/
&ELECTRONS
    conv_thr     = 1.0d-8
    mixing_beta  = 0.7
/
ATOMIC_SPECIES
    Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
    Si  0.00  0.00  0.00
    Si  0.25  0.25  0.25
K_POINTS automatic
    4 4 4  1 1 1
