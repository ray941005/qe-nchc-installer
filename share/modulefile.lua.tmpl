-- The binaries link Intel MPI and MKL shared libraries: the toolchain is a
-- hard runtime dependency, not just a build-time one.
depends_on("@TOOLCHAIN_MODULES@")

prepend_path("PATH", pathJoin(root, "bin"))
for _, libdir in ipairs({"lib", "lib64"}) do
    if isDir(pathJoin(root, libdir)) then
        prepend_path("LD_LIBRARY_PATH", pathJoin(root, libdir))
    end
end
setenv("QE_ROOT", root)

-- Matches the naming used by the site-provided chemistry modules, so loading
-- two different Quantum ESPRESSO builds at once is refused rather than
-- silently producing a mixed PATH.
